---
interface Props {
  name: "phone" | "text" | "quote" | "check" | "dash" | "star" | "menu";
}
const { name } = Astro.props;
---
{name === "star" ? (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg>
) : (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" stroke-linejoin="miter">
    {name === "phone" && <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z" />}
    {name === "text" && <path d="M4 4h16v12H9l-5 4z M8 9h8 M8 12h5" />}
    {name === "quote" && <path d="M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h7" />}
    {name === "check" && <path d="M4 12.5l5 5L20 6" />}
    {name === "dash" && <path d="M7 12h10" />}
    {name === "menu" && <path d="M4 7h16 M4 12h16 M4 17h16" />}
  </svg>
)}
